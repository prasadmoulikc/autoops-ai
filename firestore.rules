rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Assumed Data Model
    // ===============================================================
    // Collection: users
    // Fields: uid, email, displayName, role, createdAt, preferences
    //
    // Collection: transactions (subcollection of users)
    // Fields: userId, amount, type, category, description, date, gstApplicable, gstAmount
    //
    // Collection: tasks (subcollection of users)
    // Fields: userId, title, status, plan, executionLog, result, createdAt
    //
    // Collection: memory (subcollection of users)
    // Fields: userId, type, content, confidence, updatedAt
    // ===============================================================

    // Helper Functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthenticated() &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         (request.auth.token.email == "prasadgowda908@gmail.com" && request.auth.token.email_verified == true));
    }

    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email']) &&
             data.uid is string &&
             data.email is string;
    }

    function isValidTransaction(data) {
      return data.keys().hasAll(['userId', 'amount', 'type', 'date']) &&
             data.userId == request.auth.uid &&
             data.amount is number &&
             data.type in ['income', 'expense'];
    }

    function isValidTask(data) {
      return data.keys().hasAll(['userId', 'title', 'status']) &&
             data.userId == request.auth.uid &&
             data.status in ['planned', 'executing', 'completed', 'failed'];
    }

    function isValidMemory(data) {
      return data.keys().hasAll(['userId', 'type', 'content']) &&
             data.userId == request.auth.uid &&
             data.type in ['pattern', 'skill', 'preference'];
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(request.resource.data);
      allow update: if isOwner(userId) && isValidUser(request.resource.data) && 
                      (request.resource.data.role == resource.data.role || isAdmin());

      match /transactions/{transactionId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidTransaction(request.resource.data);
        allow update: if isOwner(userId) && isValidTransaction(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /tasks/{taskId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidTask(request.resource.data);
        allow update: if isOwner(userId) && isValidTask(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }

      match /memory/{memoryId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create: if isOwner(userId) && isValidMemory(request.resource.data);
        allow update: if isOwner(userId) && isValidMemory(request.resource.data);
        allow delete: if isOwner(userId) || isAdmin();
      }
    }
  }
}
